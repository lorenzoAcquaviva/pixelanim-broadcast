# HTTP address of the PixelAnim backend, reachable FROM the Broadcast container.
# If both containers share a Docker network, use the backend service/container name.
# Otherwise use a LAN address, e.g. http://192.168.1.50:9900
PIXELANIM_URL=http://192.168.1.50:9900

# Optional WebSocket override. Leave empty to derive it from PIXELANIM_URL.
PIXELANIM_WS=

BROADCAST_PORT=9910
TZ=Europe/Rome
RENDER_WORKERS=2
RENDER_MP_METHOD=fork
RENDER_CACHE_DISABLED=0
RENDER_RESULT_MAX=8
RENDER_RESULT_MAX_FRAMES=24000
PALETTE_CACHE_TTL=30

# Bearer token for global external inputs. Leave empty to disable write endpoints.
# Generate with: openssl rand -hex 32
INPUT_API_TOKEN=
